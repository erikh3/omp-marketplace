{
  "name": "hai-jwt-retry",
  "version": "0.1.0",
  "description": "Auto-retries after HAI proxy returns a JWT-expired 401, eliminating the need to manually send a continuation message.",
  "private": true,
  "omp": {
    "extensions": [
      "./src/index.ts"
    ],
    "settings": {
      "enabled": { "type": "boolean", "default": true, "description": "Enable automatic JWT-expiry retry" },
      "proxyHost": { "type": "string", "default": "localhost", "description": "HAI Proxy host (must match hai-proxy-companion if installed)" },
      "proxyPort": { "type": "number", "default": 6655, "description": "HAI Proxy port" }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.1.14",
    "@oh-my-pi/pi-ai": "^18.1.14",
    "bun-types": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
